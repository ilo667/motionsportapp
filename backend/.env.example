# Copy to .env and fill in. Only DATABASE_URL and FRONTEND_URL are needed to run locally.

# Required
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
FRONTEND_URL=http://localhost:3000

# Payments (LiqPay; sandbox_ keys = test mode). Without them online payment is unavailable
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Public URL of the callback, without /api: https://<backend>/payments/liqpay/callback
LIQPAY_SERVER_URL=

# Push notifications. Generate the keys with: npx web-push generate-vapid-keys. Without them no pushes are sent
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Daily announcement text (Gemini). Without it a fallback text is used
GEMINI_API_KEY=

# Protects /internal/cron/* (sent as "Authorization: Bearer ..."); random, at least 16 characters. Required in production
CRON_SECRET=

# Local port (default 3001)
PORT=3001

# The first trainer account is created with:
#   ADMIN_USERNAME=trainer ADMIN_PASSWORD=<long password> npm run seed:admin
